{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kuiyan-design-workbench/L1/brief-intent",
  "title": "BriefIntent",
  "type": "object",
  "required": [
    "brief_id",
    "raw_brief",
    "intent"
  ],
  "properties": {
    "brief_id": {
      "type": "string"
    },
    "raw_brief": {
      "type": "string",
      "description": "客户/内部原始 brief 文本"
    },
    "input": {
      "type": "object",
      "properties": {
        "brand": {
          "type": [
            "string",
            "null"
          ]
        },
        "product": {
          "type": [
            "string",
            "null"
          ]
        },
        "category_text": {
          "type": [
            "string",
            "null"
          ],
          "description": "自由文本品类"
        },
        "channel": {
          "type": [
            "string",
            "null"
          ],
          "description": "商超/电商/夜场/礼赠…"
        },
        "audience": {
          "type": [
            "string",
            "null"
          ]
        },
        "price_band": {
          "type": [
            "string",
            "null"
          ],
          "description": "如 入门/主流/高端/超高端"
        },
        "culture_tone": {
          "type": [
            "string",
            "null"
          ],
          "description": "中式/国际/潮/礼…"
        },
        "competitors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_have": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "occasion": {
          "type": [
            "string",
            "null"
          ]
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "kuiyan_case_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "可选：内部案例名"
        }
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "domain_id",
        "confidence",
        "analogy_plan",
        "query_plan",
        "style_prior"
      ],
      "properties": {
        "domain_id": {
          "type": "string",
          "description": "ontology primary_domains.id 或 other_fmcg"
        },
        "domain_label_zh": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "analogy_plan": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rule_id",
              "targets"
            ],
            "properties": {
              "rule_id": {
                "type": "string"
              },
              "label_zh": {
                "type": "string"
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "query_plan": {
          "type": "object",
          "properties": {
            "inspiration": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "shelf": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "analogy": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "style_prior": {
          "type": "array",
          "description": "建议风格桶 id，来自 style-buckets-v1",
          "items": {
            "type": "string"
          }
        },
        "risk_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}