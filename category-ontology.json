  "cross_analogy_rules": [
    {
      "when": "主品类感官接近（甜/苦/香）",
      "pull": [
        "巧克力↔糖果↔咖啡↔茶"
      ]
    },
    {
      "when": "礼赠/节庆场景",
      "pull": [
        "酒↔茶礼↔糕点↔滋补↔文创"
      ]
    },
    {
      "when": "健康/无糖诉求",
      "pull": [
        "低度酒↔无糖茶↔功能饮料↔轻滋补"
      ]
    },
    {
      "when": "家庭清洁/养宠",
      "pull": [
        "家清↔宠物清洁↔母婴纸品"
      ]
    },
    {
      "when": "中式现代叙事",
      "pull": [
        "黄酒↔茶↔滋补↔国潮美妆↔地方特产"
      ]
    },
    {
      "when": "国际简约/瑞士感",
      "pull": [
        "巧克力↔咖啡↔美妆↔高端水↔药妆"
      ]
    },
    {
      "when": "电商货架效率",
      "pull": [
        "任意品类 ↔ 同渠道爆款信息锤与主视觉"
      ]
    }
  ],
