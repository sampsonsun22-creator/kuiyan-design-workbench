{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kuiyan-design-workbench/L2-collector/collection-item",
  "title": "L2CollectionItem",
  "description": "Normalized L2 item for Dot Dot L3. suggested_style_buckets: prefer style_buckets_v1 English ids; v0 Chinese display names accepted in transition.",
  "type": "object",
  "required": [
    "id",
    "image_url",
    "page_url",
    "source",
    "source_type",
    "title",
    "is_on_market",
    "market_region",
    "raw_tags",
    "suggested_style_buckets",
    "structure_tags",
    "info_hierarchy_tags",
    "color_roles",
    "query_used",
    "collected_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "page_url": {
      "type": "string"
    },
    "thumbnail_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "inspiration",
        "award",
        "shelf",
        "portfolio"
      ]
    },
    "title": {
      "type": "string"
    },
    "author_or_brand": {
      "type": [
        "string",
        "null"
      ]
    },
    "category_domain_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "ontology primary_domains.id"
    },
    "category_label": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_on_market": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "market_region": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "raw_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggested_style_buckets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "chinese_modern",
          "chinese_ceremonial",
          "global_minimal",
          "swiss_international",
          "natural_organic",
          "luxury_gilt",
          "minimal_white",
          "color_youth",
          "cartoon_ip",
          "retro_nostalgia",
          "craft_material",
          "appetite_photo",
          "illustration_story",
          "efficacy_hammer",
          "regional_culture",
          "pet_cute",
          "maternal_safe",
          "nightlife_trend",
          "sustainable_plain",
          "art_collab"
        ]
      },
      "description": "style_buckets_v1 stable snake_case ids only (1–3). Empty OK if L3 will retag. See L3/style-buckets-v1.json for name_zh."
    },
    "structure_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Short codes e.g. box_type:gift_box, material:paperboard, open_structure:drawer"
    },
    "info_hierarchy_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "brand_first",
          "product_first",
          "claim_first",
          "ritual_gift"
        ]
      },
      "description": "Optional; often empty at L2, filled by L3"
    },
    "color_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "primary",
              "accent",
              "bg",
              "other"
            ]
          },
          "value": {
            "type": "string",
            "description": "hex or short descriptor"
          }
        },
        "required": [
          "role",
          "value"
        ]
      }
    },
    "structure_notes": {
      "type": [
        "string",
        "null"
      ],
      "description": "legacy free text; prefer structure_tags"
    },
    "color_palette": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "legacy; prefer color_roles"
    },
    "info_hierarchy": {
      "type": [
        "string",
        "null"
      ],
      "description": "legacy free text; prefer info_hierarchy_tags"
    },
    "analogy_from": {
      "type": [
        "string",
        "null"
      ]
    },
    "query_used": {
      "type": "string"
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "license_or_rights_note": {
      "type": [
        "string",
        "null"
      ]
    },
    "extra": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
